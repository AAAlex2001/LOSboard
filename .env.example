# --- Postgres ---
POSTGRES_DB=losboard
POSTGRES_USER=losboard
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend (FastAPI) ---
JWT_SECRET_KEY=change-me-to-something-random
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_BASE_URL=/los-control-x9k2m-admin

# Origins which are allowed to call backend (comma-separated).
# Should be your public site origin(s).
CORS_ORIGINS=https://example.com

# --- IndexNow (Yandex/Bing instant indexing) ---
# Public site origin (without trailing slash).
SITE_URL=https://example.com
# Random hex/string 32+ chars. Same value must be placed as the content of
# frontend/public/{INDEXNOW_KEY}.txt — that file proves you own the domain.
# If not set, IndexNow submissions are silently skipped.
INDEXNOW_KEY=

# --- Frontend (Next.js, baked into the build) ---
# Public origin of your backend. Browser will hit this URL.
NEXT_PUBLIC_API_BASE_URL=https://example.com/api/

# --- nginx / certbot ---
# Used in deploy README, not by compose directly.
DOMAIN=example.com
CERTBOT_EMAIL=you@example.com
